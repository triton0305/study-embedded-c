{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "GCC Build Current File",
            "type": "shell",
            "command": "gcc",
            "args": [
                "${file}",
                "-o",
                "${fileDirname}\\${fileBasenameNoExtension}.exe"
            ],
            "problemMatcher": "$gcc",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "CMake Debug Build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}\\build",
                "--config",
                "Debug"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}